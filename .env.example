# Copiar para .env na raiz. setup gera uma chave local automaticamente.
DATABASE_URL=postgresql://agrocerta:agrocerta_local@localhost:5432/agrocerta?schema=public
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
WEB_ORIGIN=http://localhost:5173
PORT=3333
NODE_ENV=development
# Cookie HTTPS obrigatório em produção; requer NODE_ENV=production.
# API e frontend devem compartilhar origem em produção (proxy /api).
