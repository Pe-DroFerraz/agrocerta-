{
  "name": "@agrocerta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate": "node ../../scripts/prisma.mjs migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/calculations.test.ts test/dates.test.ts test/permissions.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.5.2",
    "@prisma/client": "6.5.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "zod": "^4.6.7",
    "decimal.js": "^10.5.0",
    "swagger-ui-dist": "^5.17.14"
  },
  "devDependencies": {
    "prisma": "6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "@types/node": "^20.17.24",
    "@types/bcrypt": "^5.0.2",
    "vitest": "^3.0.8"
  }
}
