{
  "name": "@agrocerta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate": "node ../../scripts/prisma.mjs migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/calculations.test.ts test/dates.test.ts test/permissions.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "bcrypt": "^6.0.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.17.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/internals": "6.19.2",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.17.24",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "prisma": "6.19.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
