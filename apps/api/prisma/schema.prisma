generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  OWNER
  PRODUCTION
  SALES
  DRIVER
}

enum BatchStatus {
  IN_PRODUCTION
  MATURING
  RELEASED
  BLOCKED
  EXPIRED
  EXHAUSTED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PICKING
  READY
  IN_ROUTE
  DELIVERED
  CANCELLED
}

enum MovementType {
  PRODUCTION
  SALE
  LOSS
  ADJUSTMENT
  PURCHASE
}

model Role {
  id    String  @id @default(cuid())
  key   RoleKey @unique
  name  String
  users User[]
}

model Company {
  id                String   @id @default(cuid())
  name              String
  document          String   @unique
  city              String
  address           String
  timezone          String   @default("America/Sao_Paulo")
  expiryAlertDays   Int      @default(7)
  qualityParameters Json
  createdAt         DateTime @default(now())
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String
  active        Boolean           @default(true)
  roleId        String
  role          Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  sessions      RefreshSession[]
  receipts      MilkReceipt[]
  productions   ProductionOrder[]
  deliveries    Delivery[]
  audits        AuditLog[]
  notifications Notification[]
  announcements Announcement[]
}

model RefreshSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Producer {
  id            String        @id @default(cuid())
  name          String
  farm          String
  city          String
  phone         String
  document      String        @unique
  pricePerLiter Decimal       @db.Decimal(12, 4)
  qualityBonus  Decimal       @default(0) @db.Decimal(12, 4)
  active        Boolean       @default(true)
  deletedAt     DateTime?
  receipts      MilkReceipt[]
}

model MilkReceipt {
  id            String                 @id @default(cuid())
  date          DateTime
  producerId    String
  producer      Producer               @relation(fields: [producerId], references: [id], onDelete: Restrict)
  liters        Decimal                @db.Decimal(14, 3)
  temperature   Decimal                @db.Decimal(6, 2)
  acidity       Decimal                @db.Decimal(6, 2)
  fat           Decimal                @db.Decimal(6, 2)
  protein       Decimal                @db.Decimal(6, 2)
  scc           Int
  approved      Boolean
  pricePerLiter Decimal                @db.Decimal(12, 4)
  responsibleId String
  responsible   User                   @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  sources       ProductionMilkSource[]

  @@index([producerId, date])
  @@index([date, approved])
}

model Product {
  kgPerUnit Decimal @default(1) @db.Decimal(8,4)
  id                    String               @id @default(cuid())
  code                  String               @unique
  name                  String
  unit                  String
  category              String
  salePrice             Decimal              @db.Decimal(12, 2)
  shelfLifeDays         Int
  minimumStock          Decimal              @db.Decimal(12, 3)
  expectedLitersPerUnit Decimal              @db.Decimal(10, 3)
  photoUrl              String?
  deletedAt             DateTime?
  recipes               RecipeItem[]
  productions           ProductionOrder[]
  batches               Batch[]
  customerPrices        CustomerPrice[]
  orderItems            OrderItem[]
  recurringItems        RecurringOrderItem[]
}

model Supply {
  id           String                @id @default(cuid())
  name         String
  unit         String
  unitCost     Decimal               @db.Decimal(12, 4)
  stock        Decimal               @db.Decimal(14, 5)
  minimumStock Decimal               @db.Decimal(12, 3)
  deletedAt    DateTime?
  recipes      RecipeItem[]
  purchases    SupplyPurchase[]
  uses         ProductionSupplyUse[]
  movements    StockMovement[]
}

model SupplyPurchase {
  id        String                @id @default(cuid())
  supplyId  String
  supply    Supply                @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  lotCode   String
  date      DateTime
  expiresAt DateTime?
  quantity  Decimal               @db.Decimal(14, 3)
  unitCost  Decimal               @db.Decimal(12, 4)
  supplier  String
  uses      ProductionSupplyUse[]

  @@index([supplyId, date])
}

model RecipeItem {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId        String
  supply          Supply  @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  quantityPerUnit Decimal @db.Decimal(12, 5)

  @@unique([productId, supplyId])
}

model ProductionOrder {
  id               String                 @id @default(cuid())
  productId        String
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  date             DateTime
  litersUsed       Decimal                @db.Decimal(14, 3)
  quantityProduced Decimal                @db.Decimal(14, 3)
  lossQuantity     Decimal                @default(0) @db.Decimal(12, 3)
  milkCost         Decimal                @db.Decimal(14, 2)
  supplyCost       Decimal                @db.Decimal(14, 2)
  overheadCost     Decimal                @db.Decimal(14, 2)
  lossCost         Decimal                @db.Decimal(14, 2)
  totalCost        Decimal                @db.Decimal(14, 2)
  responsibleId    String
  responsible      User                   @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  notes            String?
  sources          ProductionMilkSource[]
  supplies         ProductionSupplyUse[]
  batch            Batch?

  @@index([date])
}

model ProductionMilkSource {
  id           String          @id @default(cuid())
  productionId String
  production   ProductionOrder @relation(fields: [productionId], references: [id], onDelete: Restrict)
  receiptId    String
  receipt      MilkReceipt     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  liters       Decimal         @db.Decimal(14, 3)

  @@unique([productionId, receiptId])
  @@index([receiptId])
}

model ProductionSupplyUse {
  id           String          @id @default(cuid())
  productionId String
  production   ProductionOrder @relation(fields: [productionId], references: [id], onDelete: Restrict)
  supplyId     String
  supply       Supply          @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  purchaseId   String
  purchase     SupplyPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(12, 5)
  unitCost     Decimal         @db.Decimal(12, 4)

  @@index([supplyId])
  @@index([purchaseId])
}

model Batch {
  id                String          @id @default(cuid())
  code              String          @unique
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productionId      String          @unique
  production        ProductionOrder @relation(fields: [productionId], references: [id], onDelete: Restrict)
  manufacturedAt    DateTime
  expiresAt         DateTime
  status            BatchStatus
  initialQuantity   Decimal         @db.Decimal(14, 3)
  availableQuantity Decimal         @db.Decimal(14, 3)
  reservedQuantity  Decimal         @default(0) @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(12, 4)
  orderItems        OrderItem[]
  movements         StockMovement[]
  losses            LossRecord[]

  @@index([productId, status, expiresAt])
}

model StockMovement {
  id        String       @id @default(cuid())
  batchId   String?
  batch     Batch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  supplyId  String?
  supply    Supply?      @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  type      MovementType
  quantity  Decimal      @db.Decimal(14, 5)
  reason    String
  reference String?
  date      DateTime     @default(now())

  @@index([batchId, date])
  @@index([supplyId, date])
}

model Customer {
  id              String            @id @default(cuid())
  name            String
  type            String
  document        String            @unique
  address         String
  neighborhood    String
  city            String
  contact         String
  phone           String
  paymentTermDays Int               @default(14)
  creditLimit     Decimal           @db.Decimal(14, 2)
  status          String            @default("ACTIVE")
  notes           String?
  deletedAt       DateTime?
  routeId         String?
  route           Route?            @relation(fields: [routeId], references: [id], onDelete: SetNull)
  prices          CustomerPrice[]
  orders          Order[]
  recurringOrders RecurringOrder[]
  messages        WhatsAppMessage[]

  @@index([name])
}

model CustomerPrice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  price      Decimal  @db.Decimal(12, 2)

  @@unique([customerId, productId])
}

model Order {
  id               String             @id @default(cuid())
  code             String             @unique
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  deliveryDate     DateTime
  status           OrderStatus
  paymentMethod    String
  total            Decimal            @db.Decimal(14, 2)
  notes            String?
  recurringOrderId String?
  recurringOrder   RecurringOrder?    @relation(fields: [recurringOrderId], references: [id], onDelete: Restrict)
  occurrenceKey    String?            @unique
  items            OrderItem[]
  history          OrderStatusEvent[]
  delivery         Delivery?
  receivable       Receivable?

  @@index([customerId, createdAt])
  @@index([deliveryDate, status])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status    OrderStatus
  date      DateTime    @default(now())
  actorName String

  @@index([orderId, date])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId   String?
  batch     Batch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)

  @@index([batchId])
}

model RecurringOrder {
  id            String               @id @default(cuid())
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  weekdays      Int[]
  paused        Boolean              @default(false)
  paymentMethod String
  items         RecurringOrderItem[]
  orders        Order[]
  exceptions    RecurringException[]
}

model RecurringException {
  id               String         @id @default(cuid())
  recurringOrderId String
  recurringOrder   RecurringOrder @relation(fields: [recurringOrderId], references: [id], onDelete: Cascade)
  date             DateTime
  skip             Boolean        @default(true)
  notes            String?

  @@unique([recurringOrderId, date])
}

model RecurringOrderItem {
  id               String         @id @default(cuid())
  recurringOrderId String
  recurringOrder   RecurringOrder @relation(fields: [recurringOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Decimal        @db.Decimal(12, 3)
}

model Route {
  id         String     @id @default(cuid())
  name       String     @unique
  city       String
  customers  Customer[]
  deliveries Delivery[]
}

model Vehicle {
  id         String     @id @default(cuid())
  plate      String     @unique
  name       String
  capacityKg Decimal    @db.Decimal(12, 3)
  deliveries Delivery[]
}

model Delivery {
  id          String          @id @default(cuid())
  orderId     String          @unique
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  routeId     String
  route       Route           @relation(fields: [routeId], references: [id], onDelete: Restrict)
  driverId    String
  driver      User            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  scheduledAt DateTime
  deliveredAt DateTime?
  stopNumber  Int
  proofUrl    String?
  signature   String?
  events      DeliveryEvent[]

  @@index([driverId, scheduledAt])
}

model DeliveryEvent {
  id          String   @id @default(cuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  date        DateTime @default(now())
  type        String
  description String
}

model Receivable {
  id         String              @id @default(cuid())
  orderId    String              @unique
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount     Decimal             @db.Decimal(14, 2)
  paidAmount Decimal             @default(0) @db.Decimal(14, 2)
  dueDate    DateTime
  payments   ReceivablePayment[]

  @@index([dueDate])
}

model ReceivablePayment {
  id           String     @id @default(cuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  amount       Decimal    @db.Decimal(14, 2)
  date         DateTime
  method       String
}

model Payable {
  payments PayablePayment[]
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Decimal  @db.Decimal(14, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(14, 2)
  dueDate     DateTime
  reference   String?

  @@index([dueDate])
}

model FixedCost {
  id       String  @id @default(cuid())
  month    String
  category String
  amount   Decimal @db.Decimal(14, 2)

  @@unique([month, category])
}

model LossRecord {
  id       String   @id @default(cuid())
  batchId  String
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity Decimal  @db.Decimal(12, 3)
  cost     Decimal  @db.Decimal(14, 2)
  reason   String
  date     DateTime

  @@index([batchId, date])
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime           @default(now())
  segment   String             @default("INTERNAL")
  sends     AnnouncementSend[]
}

model AnnouncementSend {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  recipient      String
  sentAt         DateTime
  message        String
}

model MessageTemplate {
  id      String @id @default(cuid())
  key     String @unique
  name    String
  content String
}

model WhatsAppMessage {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  direction  String
  content    String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model OperationRequest {
  id String @id
  actorId String
  route String
  requestHash String
  result Json
  createdAt DateTime @default(now())
}
model PayablePayment {
  id String @id @default(cuid())
  payableId String
  payable Payable @relation(fields:[payableId],references:[id],onDelete:Restrict)
  amount Decimal @db.Decimal(14,2)
  date DateTime
  method String
  @@index([payableId,date])
}
